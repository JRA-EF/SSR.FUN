{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/dashboard/content.ts": {
      "includeFiles": "docs/project/*.{md,json}"
    },
    "api/devnet/*.ts": {
      "includeFiles": "packages/sdk/**"
    },
    "api/kpis/*.ts": {
      "includeFiles": "packages/sdk/**"
    }
  },
  "crons": [
    {
      "path": "/api/devnet/accrue-fees-cron",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/kpis/kpis-backfill-cron",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/internal/status", "destination": "/internal-status.html" },
    { "source": "/internal/feedback", "destination": "/internal-feedback.html" },
    { "source": "/internal/kpis", "destination": "/internal-kpis.html" },
    { "source": "/road-to-mainnet", "destination": "/road-to-mainnet.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
