{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/dashboard/content.ts": {
      "includeFiles": "docs/project/*.{md,json}"
    },
    "api/devnet/*.ts": {
      "includeFiles": "packages/sdk/**"
    },
    "api/mainnet/*.ts": {
      "includeFiles": "packages/sdk/**",
      "maxDuration": 300
    },
    "api/kpis/*.ts": {
      "includeFiles": "packages/sdk/**",
      "maxDuration": 60
    },
    "api/ledger/*.ts": {
      "includeFiles": "packages/sdk/**"
    }
  },
  "crons": [
    {
      "path": "/api/devnet/accrue-fees-cron",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/kpis/kpis-backfill-cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/ledger/ingest-cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/ledger/reclassify-actors-cron",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/ledger/jupiter-snapshot-cron",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/mainnet/warm-cache-cron",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/mainnet/fee-settlement-cron",
      "schedule": "15 * * * *"
    }
  ],
  "rewrites": [
    { "source": "/internal/set-keeper", "destination": "/internal-set-keeper.html" },
    { "source": "/internal/status", "destination": "/internal-status.html" },
    { "source": "/internal/feedback", "destination": "/internal-feedback.html" },
    { "source": "/internal/kpis", "destination": "/internal-kpis.html" },
    { "source": "/road-to-mainnet", "destination": "/road-to-mainnet.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
