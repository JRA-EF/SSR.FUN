{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "middleware.ts", "lib/**/*.ts", "api/**/*.ts"],
  /* api/devnet and api/dashboard each have their own commonjs/node-resolution
     tsconfig (api/devnet/tsconfig.json, api/dashboard/tsconfig.json).
     lib/reserve-activity and lib/reserve-metadata each have their own CommonJS-scoping
     package.json (like src/merge/lib's) so ts-mocha can require() their pure logic
     directly in tests -- which conflicts with this project's nodenext module detection
     if checked here directly. All four are still fully typechecked transitively via
     api/devnet/tsconfig.json's imports of api/devnet/reserve-activity.ts (pulls in
     indexer.ts/db.ts/cursorLogic.ts) and api/devnet/reserve-metadata.ts (pulls in
     payload.ts/db.ts), plus api/dashboard/tsconfig.json's imports of
     kpis.ts/kpis-refresh.ts/kpis-backfill-cron.ts (pull in lib/reserve-activity's
     kpis.ts/backfillAll.ts/indexer.ts/db.ts the same way). */
  "exclude": ["api/devnet", "api/dashboard", "lib/reserve-activity", "lib/reserve-metadata"]
}
