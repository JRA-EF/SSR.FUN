{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "types": ["mocha", "node"],
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "packages/sdk/src/**/*.ts"]
}
