# Copy to .env.local and fill in for local development.

# --- SSR Protocol / Solana DevNet integration ---
# Client-exposed (VITE_ prefix -- Vite inlines these into the browser bundle,
# so only ever put PUBLIC values here: RPC URL, program ID, cluster name).
# All three have safe defaults baked into src/merge/lib/solana-config.ts
# pointing at the deployed DevNet program, so local dev works with none of
# this set -- override only to point at a different RPC endpoint or program.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# VITE_SSR_PROGRAM_ID=2dURvmSdHeyaFES5rxaE1zgPSHCBLW5BLNguJ2Tu1mkW
# VITE_SOLANA_CLUSTER=devnet

# Server-only (no VITE_ prefix -- never bundled into the browser). Secret key
# for the DevNet-only swap-adapter signer used by api/devnet/swap-sign.ts to
# co-sign the SOL<->fixture-asset legs of Buy/Sell zap transactions. This is
# the Gate-9 fixture "manager" keypair (devnet-fixtures/manager-keypair.json,
# gitignored, DevNet-only, holds no Mainnet value) -- see
# docs/protocol/FRONTEND_INTEGRATION.md "DevNet swap adapter" for exactly what
# it can and cannot do. Format: JSON array of the 64 secret-key bytes, e.g.
# the literal contents of a solana-keygen keypair file.
# DEVNET_SWAP_AUTHORITY_SECRET_KEY=[1,2,3,...]

# Required. Password for the /internal/status dashboard (api/dashboard/login.ts,
# lib/dashboard/session.ts). No default -- login returns 500 if unset.
SSR_DASHBOARD_PASSWORD=

# Optional. Login brute-force protection (api/dashboard/login.ts). Defaults to
# enabled only when VERCEL_ENV=production; set explicitly to override in any
# environment (e.g. to exercise the lockout path locally, or to disable it in
# a one-off production incident).
# SSR_DASHBOARD_RATE_LIMIT_ENABLED=true
# SSR_DASHBOARD_MAX_ATTEMPTS=10
# SSR_DASHBOARD_LOCKOUT_MINUTES=15
# SSR_DASHBOARD_ATTEMPT_WINDOW_MINUTES=10
