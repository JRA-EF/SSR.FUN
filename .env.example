# Copy to .env.local and fill in for local development.

# --- SSR Protocol / Solana DevNet integration ---
# Client-exposed (VITE_ prefix -- Vite inlines these into the browser bundle,
# so only ever put PUBLIC values here: RPC URL, program ID, cluster name).
# All three have safe defaults baked into src/merge/lib/solana-config.ts
# pointing at the deployed DevNet program, so local dev works with none of
# this set -- override only to point at a different RPC endpoint or program.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# VITE_SSR_PROGRAM_ID=2dURvmSdHeyaFES5rxaE1zgPSHCBLW5BLNguJ2Tu1mkW
# VITE_SOLANA_CLUSTER=devnet

# Server-only (no VITE_ prefix -- never bundled into the browser). Secret key
# for the DevNet-only swap-adapter signer used by api/devnet/swap-sign.ts to
# co-sign the SOL<->fixture-asset legs of Buy/Sell zap transactions. This is
# the Gate-9 fixture "manager" keypair (devnet-fixtures/manager-keypair.json,
# gitignored, DevNet-only, holds no Mainnet value) -- see
# docs/protocol/FRONTEND_INTEGRATION.md "DevNet swap adapter" for exactly what
# it can and cannot do. Format: JSON array of the 64 secret-key bytes, e.g.
# the literal contents of a solana-keygen keypair file.
#
# Phase B (2026-07-29) reuses this SAME variable/keypair for two more
# DevNet-only roles: the devUSDC ("SSR Test USD") mint+freeze authority and
# faucet signer (api/devnet/faucet-devusdc.ts), and the DevNet SOL onboarding
# sponsor (api/devnet/sponsor-sol.ts). This is a deliberate reuse decision
# (see docs/project/DEVNET_IMPLEMENTATION_PLAN_2026-07-29.md "Phase B --
# security model") made specifically so Phase B needs NO new required secret
# beyond this one, already-configured variable. Never place this value (or
# any authority/faucet/treasury signer) in a VITE_-prefixed or otherwise
# browser-accessible variable.
# DEVNET_SWAP_AUTHORITY_SECRET_KEY=[1,2,3,...]

# --- Server-side RPC endpoints (api/devnet/_lib/rpc.ts, api/mainnet/_lib/rpc.ts) ---
# Server-only. The browser never sees these: in production builds the app
# reaches each cluster only through the same-origin /api/{devnet,mainnet}/
# rpc-proxy, which reads the matching variable here. DevNet falls back to the
# public endpoint when neither is set; Mainnet uses HELIUS_MAINNET_RPC_URL
# only (MAINNET_RPC_URL is a fallback for api/ledger/known-asset-mints.ts).
# HELIUS_RPC_URL=
# SOLANA_RPC_URL=
# HELIUS_MAINNET_RPC_URL=
# MAINNET_RPC_URL=
# Robinhood Chain (EVM) keyed RPC behind api/robinhood/rpc-proxy.ts. Only
# needed when the EVM surface is built in (VITE_ENABLE_EVM below).
# ROBINHOOD_RPC_URL=

# Required by every cron in vercel.json (accrue-fees, kpis-backfill, ledger
# ingest/reclassify/jupiter-snapshot, warm-cache, fee-settlement). Requests
# must carry `Authorization: Bearer $CRON_SECRET`; Vercel sets this header on
# scheduled invocations automatically.
# CRON_SECRET=

# Required. Neon Postgres connection string shared by every lib/*/db.ts
# (ledger, reserve-activity, reserve-metadata/image/entry-price, warm-cache,
# rate-limit, road-to-mainnet). Run scripts/migrate-*.mjs against it once.
# DATABASE_URL=

# --- Closed-beta site gate (middleware.ts, lib/site/session.ts) ---
# Gate 1 sits in front of the WHOLE site and every /api route except crons,
# /api/site/login and the Coming Soon page's own files. Set
# SSR_SITE_GATE_ENABLED=false (the literal string) to switch it off, e.g. for
# a local `vercel dev` session.
# SSR_SITE_GATE_ENABLED=true
# Which page an ungated visitor sees: the default Coming Soon page, or an
# inline password form when set to "password".
# SSR_SITE_GATE_MODE=coming-soon
# Keys redeemed at /api/site/login. SSR_SITE_PASSWORD doubles as the HMAC
# secret that signs the ssr_site_session cookie -- leaving it empty disables
# site sign-in entirely. BETA keys and the site password grant a 30-day
# session; TEAM keys (comma-separated) grant 400 days.
# SSR_SITE_PASSWORD=
# SSR_BETA_KEYS=
# SSR_TEAM_KEYS=
# Optional. Site-login lockout (api/site/login.ts); same defaults and
# override semantics as the SSR_DASHBOARD_* lockout settings below.
# SSR_SITE_RATE_LIMIT_ENABLED=true
# SSR_SITE_MAX_ATTEMPTS=10
# SSR_SITE_LOCKOUT_MINUTES=15
# SSR_SITE_ATTEMPT_WINDOW_MINUTES=10

# Required. Password for the /internal/status dashboard (api/dashboard/login.ts,
# lib/dashboard/session.ts). No default -- login returns 500 if unset.
SSR_DASHBOARD_PASSWORD=

# Optional. Login brute-force protection (api/dashboard/login.ts). Defaults to
# enabled only when VERCEL_ENV=production; set explicitly to override in any
# environment (e.g. to exercise the lockout path locally, or to disable it in
# a one-off production incident).
# SSR_DASHBOARD_RATE_LIMIT_ENABLED=true
# SSR_DASHBOARD_MAX_ATTEMPTS=10
# SSR_DASHBOARD_LOCKOUT_MINUTES=15
# SSR_DASHBOARD_ATTEMPT_WINDOW_MINUTES=10

# --- Mainnet fee settlement keeper (api/mainnet/fee-settlement-cron.ts) ---
# Server-only secret key (JSON array of 64 bytes) for the keeper wallet that
# runs the hourly USDC settlement pipeline: redeem fee-vault shares, swap each
# asset through Jupiter under a bounded on-chain approval, then
# distribute_fee_usdc to the Treasury and Manager recipients. It also pays the
# transaction fees, so keep it topped up with SOL. Job A only runs once the
# on-chain SettlementKeeperConfig points at this same wallet
# (/internal/set-keeper). Never prefix with VITE_.
# SSR_FEE_SETTLEMENT_KEEPER_SECRET=[1,2,3,...]

# --- Jupiter (lib/mainnet/jupiter.ts, api/mainnet/build-buy|build-sell|jupiter-swap.ts) ---
# Required on Mainnet deployments: Swap, Quote, Price and Tokens APIs all
# send it as `x-api-key`. Obtain from https://portal.jup.ag. Server-only.
# JUPITER_API_KEY=
# Optional, LOCAL dry runs only: point at the key-less lite endpoint when the
# production key is not on the machine. Production never sets this.
# JUPITER_API_BASE=https://lite-api.jup.ag
# Optional. Comma-separated DEX names to exclude from Jupiter routing. Unset =
# the built-in default (ZeroFi, Quantum -- see lib/mainnet/jupiter.ts for the
# incident behind it); an empty string disables the default.
# JUPITER_EXCLUDE_DEXES=ZeroFi,Quantum

# --- Mainnet USD pricing layer (api/mainnet/asset-prices.ts) ---
# Reuses JUPITER_API_KEY above (Jupiter Price API V3, the fallback pricing
# source) -- no separate key needed. Pyth Core (the primary source) needs no
# API key at all (Hermes is a public REST endpoint).
#
# Optional. Overrides Pyth's Hermes REST base URL -- exists specifically so
# Pyth's announced 26 August 2026 Core upgrade can be absorbed as a
# deployment config change if it moves/versions the endpoint, without a code
# change. Defaults to https://hermes.pyth.network.
# PYTH_HERMES_BASE_URL=https://hermes.pyth.network

# /internal/feedback (gated by the SAME SSR_DASHBOARD_PASSWORD session above)
# is a simple link-through to a manually-maintained Google Sheet -- no
# backend, no env vars of its own. An earlier Drive/Sheets-API-automated
# version was tried and abandoned after hitting organization policy
# blockers (service-account key creation / external sharing restrictions);
# see docs/project/DECISION_LOG.md.

# --- SSR Ledger (docs/protocol/LEDGER_ARCHITECTURE.md) ---
# DATABASE_URL (Neon Postgres connection string) is already required by
# lib/road-to-mainnet/ and lib/reserve-activity/ -- the Ledger reuses that
# same variable, no separate database credential needed.

# Required for api/ledger/jupiter-snapshot-cron.ts's weekly catalogue
# snapshot (requirement 9) -- Jupiter Tokens API V2 requires an `x-api-key`
# header. Obtain from https://portal.jup.ag. Server-only -- never prefix
# with VITE_, never expose to the browser. Without this set, the cron
# endpoint returns a clear 503 explaining exactly what's missing rather
# than silently skipping or fabricating an empty catalogue.
# JUPITER_API_KEY=

# Optional. Which cluster api/ledger/ingest-cron.ts and
# reclassify-actors-cron.ts work on. The code default is still 'devnet';
# the production deployment must set 'mainnet-beta' explicitly (Mainnet
# program live since 2026-08-19, DEC-0115) -- see LEDGER_ARCHITECTURE.md
# section 11.
# LEDGER_CLUSTER=mainnet-beta

# CRON_SECRET is already required by api/devnet/accrue-fees-cron.ts and
# api/kpis/kpis-backfill-cron.ts -- api/ledger/ingest-cron.ts and
# api/ledger/jupiter-snapshot-cron.ts reuse that same variable.

# Reserve Token Metaplex metadata (packages/sdk/src/tokenMetadata.ts): set to
# "true" only once the program on the targeted cluster has executed the upgrade
# that adds set_reserve_token_metadata. Off (unset) = launches do not bundle
# the instruction and the Manage page hides the publish control.
# VITE_TOKEN_METADATA_LIVE=true

# Robinhood Chain (EVM) surface (src/merge/lib/evmFeature.ts). BUILD-time
# flag, inlined by Vite: "true" compiles the /evm app, cross-chain Discover
# and the chain choice in Launch step 1 into the bundle. Off (unset) = pure
# Solana build. Production (ssr.fun) currently ships with it off.
# VITE_ENABLE_EVM=true

# Agent-feedback pipeline (api/feedback/*, tools/agent-feedback-daemon).
# Bearer secret shared between the Vercel routes and the local fixer daemon;
# routes return 500 when unset. See api/feedback/README.md.
# FEEDBACK_DAEMON_SECRET=

# Launchpad provenance for the Reserve Asset catalogue (api/ledger/
# launchpad-classify-cron.ts, packages/sdk/src/launchpads.ts): daily on-chain
# classification of catalogue mints as Pump.fun / LetsBONK.fun / Bags.fm.
# Needs the server-side HELIUS_MAINNET_RPC_URL above and CRON_SECRET. Set to
# "false" to pause the cron (existing labels stay; nothing is deleted).
# LAUNCHPAD_DETECTION_ENABLED=true
